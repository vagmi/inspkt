# Copy to .dev.vars and fill in. Never commit .dev.vars.
# These are the server-side secrets the baseline (Clerk auth) needs.
# Skills add their own keys on install (e.g. POLAR_ACCESS_TOKEN for billing-polar,
# RESEND_API_KEY for email-resend, SVIX_API_KEY, R2_PUBLIC_BASE_URL).

CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Optional: only needed if you wire up the Clerk -> D1 org-sync webhook.
# Orgs are also mirrored lazily on first request, so you can skip this for the workshop.
CLERK_WEBHOOK_SECRET=whsec_xxx

APP_URL=http://localhost:5173

# Urai chat widget (setup assistant).
# URAI_CHAT_BASE: chat-service origin the browser widget talks to.
#   Default hosted: https://chat.app.urai.dev ; local dev: http://localhost:5174
# URAI_WIDGET_TOKEN: public widget token from the Urai dashboard.
# WIDGET_TOKEN_SECRET: signs short-lived `inspktw_` tokens the widget's UraiJS
#   tools use to call our API. Any random string; rotating it invalidates all
#   live widget tokens. Generate: openssl rand -hex 32
URAI_CHAT_BASE=http://localhost:5174
URAI_WIDGET_TOKEN=
WIDGET_TOKEN_SECRET=
